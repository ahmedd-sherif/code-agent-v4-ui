# Google Agent Development Kit Configuration
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY

# GitHub Integration (for creating repos and pushing code)
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_github_username

# LLM Providers (Optional depending on usage)
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_key

# Web Search Capability
TAVILY_API_KEY=your_tavily_api_key

# Local vs Remote Model Configuration
# Set to True to use local Ollama (http://localhost:11434)
# Set to False to use Ngrok remote tunnel (requires updating server.py with URL)
USE_LOCAL_OLLAMA=True
